<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: обновление идёт без консольного окна, ошибки — в MessageBox. -->
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8: лёгкий EXE без установки .NET 8 (он уже есть
         внутри папки лаунчера в self-contained сборке). -->
    <TargetFramework>net48</TargetFramework>
    <!-- Строго C# 7.3: updater должен собираться теми же средствами, что и
         загрузчик (никаких using var, is not, records и т.п.). -->
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>EscBUpdater</RootNamespace>
    <AssemblyName>EscBUpdater</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>EscB</Authors>
    <Product>EscB Updater</Product>
    <Description>Проверка обновлений и запуск EscB Client</Description>
    <ApplicationIcon>..\icon.ico</ApplicationIcon>
    <!-- Не плодить .pdb рядом с лёгким EXE. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
